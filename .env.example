# FoodieHub API production configuration
# Set DATABASE_URL to the Neon pooled PostgreSQL URL for PostgreSQL storage.
# Leave blank to use the local SQLite fallback. Never commit a real connection URL.
DATABASE_URL=
NODE_ENV=production
PORT=3000
DATA_DIR=/var/data
ALLOWED_ORIGINS=https://shagun299.github.io
FIREBASE_PROJECT_ID=foodiehub-43023
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash-from-the-helper
ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
